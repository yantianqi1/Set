DATABASE_URL="postgresql://postgres:postgres@localhost:5432/image_set_studio?schema=public"
CONFIG_ENCRYPTION_KEY="replace-with-a-long-random-secret"
POLLINATIONS_DEFAULT_PLANNING_MODEL="openai"
