{
  "name": "@image-set-studio/api",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@image-set-studio/shared": "workspace:*",
    "@prisma/client": "6.19.2",
    "fastify": "^5.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "tsx": "^4.20.6",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "prisma generate --schema ../../prisma/schema.prisma && tsc -p tsconfig.json",
    "dev": "prisma generate --schema ../../prisma/schema.prisma && node --env-file=.env --watch --import tsx src/index.ts",
    "prisma:generate": "prisma generate --schema ../../prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema ../../prisma/schema.prisma",
    "start": "node --env-file=.env dist/src/index.js",
    "test": "vitest run --config vitest.config.ts"
  }
}
